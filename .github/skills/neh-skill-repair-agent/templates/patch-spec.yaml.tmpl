# Patch specification — one file per deterministic defect.
# Rendered by the planner (workflow step 4); consumed by apply_patch (step 5).
# JUDGMENT-class defects never get a spec — they go straight to the escalation table.

patch_id: "{unit}-{defect_code}-{seq}"        # e.g. pillar-brand-doc-engine-RENDER_MISSING_LATER-01
unit: "{unit}"                                # skill folder name under the library root
defect:
  code: "{defect_code}"                       # code from references/defect-taxonomy.md
  class: DETERMINISTIC                        # the only class apply_patch accepts
  severity: "{severity}"                      # S0–S4, copied from the register
  evidence:
    file: "{relative/path/in/unit}"
    detail: "{what the scanner saw, verbatim enough to re-find it}"

edit:
  kind: "{edit_kind}"                         # one of: replace_glyph | set_frontmatter_name |
                                              #         normalize_version | reformat_prov_date |
                                              #         remove_empty_dir | clone_later_template
  params: {}                                  # kind-specific, fully literal — no judgment inputs

bookkeeping:                                  # applied atomically with the edit
  version_bump: patch                         # always PATCH level; never minor/major
  changelog_entry: "{one-line entry, mechanical wording}"
  provenance:
    last_modified_on: CLD
    last_modified_at: "{run_date}"            # YYYY-MM-DD
    # last_modified_by is preserved from the unit, never invented

verify:
  probe: "{render_probe | rescan}"            # render_probe for engine units, rescan otherwise
  expect: "{defect_code} absent"              # probe PASS condition
  on_fail: revert                             # restore from pristine copy; log S1; do not package
